# ChamaPot environment. Copy to .env.local (git-ignored) and fill in. Never commit real values.

# --- Supabase (shared project; ChamaPot only uses chama_* tables) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key (Project Settings -> API Keys). Server only: webhooks, payouts, rules.
SUPABASE_SECRET_KEY=

# --- PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
# Enable the app features: Invoicing, Payouts, Transaction search.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Public copy of the client id for the JS SDK v6 button (same value as PAYPAL_CLIENT_ID).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Webhook id from `npm run paypal:webhook` (or the developer dashboard). Required to verify webhooks.
PAYPAL_WEBHOOK_ID=
# A sandbox PERSONAL account email (developer.paypal.com -> Sandbox -> Accounts). Receives the demo payout.
PAYPAL_SANDBOX_PERSONAL_EMAIL=

# --- Claude (console.anthropic.com) ---
ANTHROPIC_API_KEY=
CHAMAPOT_MODEL=claude-sonnet-5-5
CHAMAPOT_EXTRACT_MODEL=claude-opus-5-5
# Max AI requests per IP per hour on the public demo.
CHAMAPOT_AI_RATE_LIMIT=40

# --- AG Studio licence (45-day trial from ag-grid.com). Without it Studio shows a watermark. ---
AG_STUDIO=

# --- Public site URL (used for PayPal webhook registration and links) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
